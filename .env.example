# Pulse Ratings Brasil Environment Variables Config Example
# Copy this file to '.env' and fill in your values.

# S&P Global Scraper
# (Optional: if not provided, the scraper will extract the public key dynamically from the website)
SP_GLOBAL_API_KEY=your_sp_global_api_key_here

# CNPJ Aberto API (para preencher CNPJ dos emissores via preencher_cnpj_api.py)
# Obrigatório para o script preencher_cnpj_api.py. Free tier: 1.000 req/dia.
# Cadastre-se em https://cnpjaberto.com.br/planos para obter sua chave.
CNPJABERTO_API_KEY=your_cnpj_aberto_api_key_here

# SearXNG (opcional, para preencher_cnpj_web.py)
# Meta-buscador self-hosted sem API key. Rode: docker run -p 8888:8080 searxng/searxng
# Se não definido, usa http://localhost:8888/search
SEARXNG_URL=http://localhost:8888/search

# Brave Search API (opcional, para preencher_cnpj_web.py)
# Fallback quando DuckDuckGo não retorna resultados. Free tier: 2.000 consultas/mês.
# Cadastre-se em https://brave.com/search/api/ para obter sua chave.
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Bing Web Search API (opcional, para preencher_cnpj_web.py)
# Fallback quando DuckDuckGo e Brave não retornam resultados. Free tier: 1.000 consultas/mês.
# Cadastre-se em https://portal.azure.com para obter sua chave.
# BING_SEARCH_API_KEY=your_bing_search_api_key_here

# Databricks (opcional)
# Define o diretório de saída dos CSVs no DBFS quando executando no Databricks.
# Se não definido, os dados serão salvos em data/ (comportamento padrão).
# Deve ser um path absoluto no DBFS, ex: /dbfs/FileStore/pulse_ratings/data
# DATABRICKS_DATA_PATH=/dbfs/FileStore/pulse_ratings/data
