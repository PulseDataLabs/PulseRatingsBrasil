# Pulse Ratings Brasil Environment Variables Config Example
# Copy this file to '.env' and fill in your values.

# S&P Global Scraper
# (Optional: if not provided, the scraper will extract the public key dynamically from the website)
SP_GLOBAL_API_KEY=your_sp_global_api_key_here

# CNPJ Aberto API (para preencher CNPJ dos emissores via preencher_cnpj_api.py)
# Obrigatório para o script preencher_cnpj_api.py. Free tier: 1.000 req/dia.
# Cadastre-se em https://cnpjaberto.com.br/planos para obter sua chave.
CNPJABERTO_API_KEY=your_cnpj_aberto_api_key_here
